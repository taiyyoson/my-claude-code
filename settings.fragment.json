{
  "_comment": "Merged into ~/.claude/settings.json by install.sh. Only permissions.allow and permissions.deny are read from here; hooks are generated by the installer so paths stay correct if this repo moves. Everything else in settings.json is left untouched.",

  "_allow_rationale": "Read-only and routine build commands, pre-approved so prompts stay rare and the guard hook is the thing you actually notice. Nothing here mutates remote state or touches credentials.",
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch)",
      "Bash(git branch *)",
      "Bash(git rev-parse *)",
      "Bash(git stash *)",
      "Bash(git worktree list)",
      "Bash(git blame *)",

      "Bash(go build *)",
      "Bash(go test *)",
      "Bash(go vet *)",
      "Bash(go fmt *)",
      "Bash(go mod tidy)",
      "Bash(go doc *)",
      "Bash(gofmt *)",

      "Bash(make)",
      "Bash(make *)",
      "Bash(cargo build *)",
      "Bash(cargo test *)",
      "Bash(cargo clippy *)",
      "Bash(cargo check *)",

      "Bash(npm test *)",
      "Bash(npm run *)",
      "Bash(npm ls *)",
      "Bash(npm -v)",
      "Bash(npx skills *)",
      "Bash(pnpm *)",

      "Bash(python -m pytest *)",
      "Bash(pytest *)",
      "Bash(ruff *)",
      "Bash(mypy *)",

      "Bash(rg *)",
      "Bash(jq *)",
      "Bash(ls *)",
      "Bash(wc *)",
      "Bash(file *)",
      "Bash(tree *)",
      "Bash(which *)",
      "Bash(du *)",
      "Bash(env)",

      "Bash(gcc --version)",
      "Bash(g++ --version)",
      "Bash(brew --version)",
      "Bash(claude --version)",
      "Bash(claude plugin list)",
      "Bash(claude plugin details *)",

      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh issue view *)",
      "Bash(gh issue list *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",

      "WebFetch(domain:github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:pkg.go.dev)",
      "WebFetch(domain:docs.anthropic.com)"
    ],

    "_deny_rationale": "Belt to the hook's braces. The mode-guard hook is the real enforcement (it sees full command text and can explain itself); these globs are a cheap second layer in case the hook is ever unloaded — note that --bare skips hooks entirely.",
    "deny": [
      "Bash(sudo *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)",
      "Bash(git clean -fdx *)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.gnupg/**)",
      "Read(**/*.pem)",
      "Read(~/.netrc)"
    ]
  }
}
